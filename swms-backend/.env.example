PORT=3000
API_SERVER_URL=http://localhost:3000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=SWMS_db
DB_PASS=replace-with-your-postgres-password
DB_PORT=5432
DB_CONNECTION_LIMIT=10
# Local development only; production must use verify-full.
DB_SSL_MODE=disable
# Optional CA bundle for a private/managed PostgreSQL certificate.
# DB_SSL_CA_FILE=C:\certs\postgres-ca.pem
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=swms-api
JWT_AUDIENCE=swms-api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
# A device is considered online for this many seconds after a valid hardware message.
DEVICE_ONLINE_WINDOW_SECONDS=300
# Set the exact trusted reverse-proxy hop count only when deployed behind a proxy.
TRUST_PROXY_HOPS=0
# Required in production for shared rate limits; use rediss:// in production.
# REDIS_URL=redis://localhost:6379

# Request limits are shared through Redis in production. Device limits are per device per minute.
API_RATE_LIMIT_PER_15_MINUTES=600
AUTH_RATE_LIMIT_PER_15_MINUTES=60
DEVICE_INGESTION_IP_LIMIT_PER_MINUTE=12000
GPS_DEVICE_INGESTION_LIMIT_PER_MINUTE=600
IOT_DEVICE_INGESTION_LIMIT_PER_MINUTE=120

# Used only by `npm run create-admin`.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Development-only simulator control interface (must stay false/unset in production).
SWMS_ENABLE_SIMULATOR=false
